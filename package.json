{
  "name": "@robertying/thu-learn-lib",
  "version": "8.0.0",
  "description": "a JavaScript library to provide a program-friendly interface to Web Learning (2018) of Tsinghua University",
  "keywords": [
    "learn2018",
    "tsinghua"
  ],
  "license": "MIT",
  "author": "Rui Ying (https://github.com/robertying)",
  "contributors": [
    "Harry Chen <harry-chen@outlook.com> (https://harrychen.xyz)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertying/thu-learn-lib.git"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cookies": {
      "types": "./lib/cookies.d.ts",
      "default": "./lib/cookies.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "OPENSSL_CONF=test/live/openssl.cnf vitest run --config vitest.live.config.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "entities": "^9.0.0",
    "fetch-cookie": "^3.2.0",
    "js-base64": "^3.9.3",
    "sm-crypto": "^0.5.7",
    "tough-cookie": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/sm-crypto": "0.3.4",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "18.0.10",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.19.0+sha512.87327b6619853205834e4be59ba3a231e303d9f5e435912ede3312b7539b79af890942f6513b05a4690745666888045c09b33fc420c2cd2d3bd95c01ba21dbeb"
}
