# Copy to test/live/.env (not the repo root) and fill in your own account.
USERNAME=yourTsinghuaUsername
PASSWORD=yourTsinghuaPassword
# device fingerprint id.tsinghua.edu.cn asks for (any stable string, e.g. the one learnX stores)
FINGERPRINT=yourFingerprint

# Optional: the semester and course to test with, as a student and as a teacher / TA.
# Found automatically (the first semester with a course) when left out.
STUDENT_SEMESTER=2025-2026-1
STUDENT_COURSE=
TEACHER_SEMESTER=
TEACHER_COURSE=

# Off by default: the tests refuse requests that change something on the server (submit homework, favorites,
# comments, course order). Set to 1 to run the tests that change favorites.
# LIVE_ALLOW_WRITES=1
# One-time checks in once.test.ts that leave a trace on the account, comma-separated: wrong-password, read-mark,
# favorite (adds one homework to favorites and removes it; also needs LIVE_ALLOW_WRITES=1).
# Run them alone and before the other live tests. Later runs warn when one is due again.
# LIVE_ONCE=read-mark
