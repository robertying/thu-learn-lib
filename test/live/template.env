# Copy to test/live/.env (not the repo root) and fill in your own account.
USERNAME=yourTsinghuaUsername
PASSWORD=yourTsinghuaPassword
# device fingerprint id.tsinghua.edu.cn asks for (any stable string, e.g. the one learnX stores)
FINGERPRINT=yourFingerprint

# Optional: the semester and course to test with, as a student and as a teacher / TA.
# Found automatically (the first semester with a course) when left out.
STUDENT_SEMESTER=2025-2026-1
STUDENT_COURSE=
TEACHER_SEMESTER=
TEACHER_COURSE=
