# Copy to test/live/.env (not the repo root) and fill in your own account.
U=yourTsinghuaUsername
P=yourTsinghuaPassword
# device fingerprint id.tsinghua.edu.cn asks for (any stable string, e.g. the one learnX stores)
FP=yourFingerprint
# optional: semester and course to test with (found automatically when left out)
S=semester1
C=course1
ST=semester2
CT=course2
